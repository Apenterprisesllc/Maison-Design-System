# Supabase — public, safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role — secret. Only used by scripts/ (e.g. npm run bootstrap).
# Never expose this to the browser. Vite ignores vars without VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap defaults — change before first prod run.
# Used by `npm run bootstrap` to create the super_admin + a property manager
# for `the-arden` so the client can log in without touching the Supabase dashboard.
BOOTSTRAP_ADMIN_EMAIL=admin@apenterprises.test
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin2026!
BOOTSTRAP_ADMIN_NAME=AP Enterprises Admin

BOOTSTRAP_MANAGER_EMAIL=manager@thearden.test
BOOTSTRAP_MANAGER_PASSWORD=ChangeMeManager2026!
BOOTSTRAP_MANAGER_NAME=Arden Property Manager
BOOTSTRAP_MANAGER_PROPERTY_SLUG=the-arden

# Optional demo residents — created by `npm run bootstrap` only if all the
# RESIDENT_* / CLIENT_* vars are present. Skip if you want the residents
# table empty until the manager invites the first one from /ops/residences.
BOOTSTRAP_RESIDENT_EMAIL=resident@thearden.test
BOOTSTRAP_RESIDENT_PASSWORD=ChangeMeResident2026!
BOOTSTRAP_RESIDENT_NAME=Eleanor Ashcombe
BOOTSTRAP_RESIDENT_PROPERTY_SLUG=the-arden
BOOTSTRAP_RESIDENT_UNIT=1402

BOOTSTRAP_CLIENT_EMAIL=cafe@thearden.test
BOOTSTRAP_CLIENT_PASSWORD=ChangeMeCommercial2026!
BOOTSTRAP_CLIENT_NAME=Arden Café & Bar
BOOTSTRAP_CLIENT_PROPERTY_SLUG=the-arden
BOOTSTRAP_CLIENT_UNIT=C-02
